# Server
PORT=3000

# Primary provider: OpenRouter powers both fighters and the judge.
# Add this key on Render to turn on model selection.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://ai-battle-arena.furqankhan.dev
OPENROUTER_APP_TITLE=Model Arena

# Fallback provider: used only while OPENROUTER_API_KEY is empty.
COHERE_API_KEY=
GROQ_API_KEY=

# Optional clients, not on the main path.
GOOGLE_API_KEY=
MISTRALAI_API_KEY=
